# ===== teamwork-server M0 =====
# 监听（内网办公网；v3.2 部署规格）
PORT=8787
HOST=0.0.0.0

# 工作组（加入时用 Wpassword 换 token）
WORKSPACE_NAME=TeamWork-Demo
WORKSPACE_PASSWORD=change-me

# Leader 名（发布权限校验 M0 简化：token 即权限）
LEADER_NAME=leader

# ===== 飞书持久层（自动同步，autoPush=on）=====
TEAMWORK_FEISHU_ENABLED=true
FEISHU_APP_ID=cli_aa46d13079b99bc2
FEISHU_APP_SECRET=

# ===== L3 引擎（M1：agentmemory sidecar）=====
AGENTMEMORY_URL=127.0.0.1:3111
AGENTMEMORY_SECRET=

# ===== 评分器（Design 4.11.2 场景权重，M0 用默认）=====
