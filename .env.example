# ===== teamwork-server M0 =====
# 监听（内网办公网；v3.2 部署规格）
PORT=8787
HOST=0.0.0.0

# 工作组（加入时用 Wpassword 换 token）
WORKSPACE_NAME=TeamWork-Demo
WORKSPACE_PASSWORD=change-me

# Leader 名（发布权限校验 M0 简化：token 即权限）
LEADER_NAME=leader

# ===== 飞书持久层（自动同步，autoPush=on）=====
# 前置（必需）：自备飞书开放平台「企业自建应用」——权限管理开通云文档权限
# drive:drive / docx:document（应用身份列）并「创建版本发布」；详见 docs/getting-started.md「飞书接入」
TEAMWORK_FEISHU_ENABLED=true
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=
# 共享根目录 token（可选）：推荐 Leader 在飞书云文档预建一个共享目录，复制其 folder token 填入。
# 不配置时应用身份自动在其云空间创建/发现 TeamWork-Demo/ 根目录；绑定个人身份的成员建议显式配置
FEISHU_ROOT_FOLDER=

# ===== L3 引擎（M1：agentmemory sidecar）=====
AGENTMEMORY_URL=127.0.0.1:3111
AGENTMEMORY_SECRET=

# ===== 评分器（Design 4.11.2 场景权重，M0 用默认）=====
# SCORER_HALFLIFE_HOURS=24
